# OneTable muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env.local  — va qiymatlarni to'ldiring.
# .env.local hech qachon git'ga qo'shilmaydi.

# Supabase (Project Settings → API). Publishable kalit brauzerga chiqishi mumkin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry (ixtiyoriy). Bo'sh bo'lsa xato monitoringi o'chiq.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Keyingi sprintlarda qo'shiladi (faqat serverda, NEXT_PUBLIC_ siz):
# SUPABASE_SECRET_KEY=        # Sprint 2 — faqat server tomonidagi admin vazifalar
# ESKIZ_EMAIL= / ESKIZ_PASSWORD=   # Sprint 3 — SMS OTP (Supabase Edge Function secret sifatida)
# TELEGRAM_BOT_TOKEN=         # Sprint 8
# NEXT_PUBLIC_YANDEX_MAPS_API_KEY=  # Sprint 5 — domen bo'yicha cheklangan kalit
