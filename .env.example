# Telegram Guard — namuna konfiguratsiya. Nusxa oling: cp .env.example .env

# --- Bot (xavfsiz rejim) ---
# @BotFather dan oling. Bu BOT tokeni — foydalanuvchi akkaunti emas.
# Bot hech kimning akkauntiga kira olmaydi.
BOT_TOKEN=
# Ixtiyoriy: botni/mini app’ni faqat shu Telegram foydalanuvchi id’si uchun cheklash.
BOT_OWNER_ID=
# Ixtiyoriy: Mini App’ning ommaviy HTTPS manzili (WebApp tugmasi uchun).
MINIAPP_URL=
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8720

# Lokal holat papkasi (chatlar bo‘yicha tekshiruv ro‘yxati holati).
STATE_DIR=~/.telegram-guard

# Log darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Manual himoya: avtomatik sessiya tugatish o‘chiq (o‘zgartirmang).
GUARD_MODE=manual
AUTO_TERMINATE_SESSIONS=false
